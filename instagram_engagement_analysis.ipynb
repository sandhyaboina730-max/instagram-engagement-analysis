import os
import glob
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from IPython.display import display

warnings.filterwarnings("ignore")

BASE_DIR = "/kaggle/input"
OUTPUT_DIR = "/kaggle/working"
os.makedirs(OUTPUT_DIR, exist_ok=True)

# ================================================================
# 1. AUTOMATICALLY FIND AND LOAD CSV FILES
# ================================================================

all_csv_files = glob.glob(
    os.path.join(BASE_DIR, "**", "*.csv"),
    recursive=True
)

if not all_csv_files:
    raise FileNotFoundError(
        "No CSV files found. Attach your dataset using Kaggle Add Input."
    )

file_map = {}

for path in all_csv_files:
    filename = os.path.basename(path).strip().lower()
    file_map[filename] = path

print("=" * 65)
print("INSTAGRAM ENGAGEMENT ANALYSIS - ALFIDO TECH")
print("=" * 65)

print("\nCSV FILES FOUND:")
for path in all_csv_files:
    print(path)


def load_csv(filename, required=False):
    path = file_map.get(filename.lower())

    if path is None:
        if required:
            raise FileNotFoundError(
                f"{filename} is missing. Attach the correct dataset."
            )
        print(f"WARNING: {filename} not found.")
        return None

    df = pd.read_csv(path)

    # Normalize column names
    df.columns = [
        str(c).strip().lower().replace(" ", "_")
        for c in df.columns
    ]

    print(f"Loaded {filename}: {df.shape}")
    print("Columns:", df.columns.tolist())

    return df


users = load_csv("users.csv", required=True)
photos = load_csv("photos.csv", required=True)
likes = load_csv("likes.csv", required=True)
follows = load_csv("follows.csv", required=True)

comments = load_csv("comments.csv")
photo_tags = load_csv("photo_tags.csv")
tags = load_csv("tags.csv")

# ================================================================
# 2. HELPER FUNCTIONS
# ================================================================

def normalize_name(name):
    return (
        str(name).lower()
        .replace("_", "")
        .replace("-", "")
        .replace(" ", "")
    )


def find_col(df, candidates, required=True):
    if df is None:
        if required:
            raise ValueError("Required dataset is unavailable.")
        return None

    normalized = {
        normalize_name(c): c
        for c in df.columns
    }

    for candidate in candidates:
        key = normalize_name(candidate)
        if key in normalized:
            return normalized[key]

    if required:
        raise ValueError(
            f"Column not found: {candidates}\n"
            f"Available columns: {df.columns.tolist()}"
        )

    return None


def save_csv(df, filename, index=False):
    path = os.path.join(OUTPUT_DIR, filename)
    df.to_csv(path, index=index)
    print("Saved:", path)


def save_chart(filename):
    plt.tight_layout()
    plt.savefig(
        os.path.join(OUTPUT_DIR, filename),
        dpi=150,
        bbox_inches="tight"
    )
    plt.show()
    plt.close()


# ================================================================
# 3. IDENTIFY COLUMNS
# Supports both standard names and names in your screenshot.
# ================================================================

user_id_col = find_col(
    users,
    ["id", "user_id", "userid", "user"]
)

photo_id_col = find_col(
    photos,
    ["id", "photo_id", "photoid", "photo"]
)

photo_user_col = find_col(
    photos,
    ["user_id", "userid", "owner_id", "user"]
)

photo_date_col = find_col(
    photos,
    [
        "created_at", "created_date", "created_time",
        "createdat", "posted_at", "post_date",
        "date", "timestamp"
    ],
    required=False
)

# Actual likes.csv columns in your screenshot include:
# user, photo, created_time, following_or_not, like_type

like_photo_col = find_col(
    likes,
    ["photo_id", "photoid", "photo"]
)

like_user_col = find_col(
    likes,
    ["user_id", "userid", "user"],
    required=False
)

follower_col = find_col(
    follows,
    ["follower_id", "followerid", "follower", "user1"]
)

followee_col = find_col(
    follows,
    [
        "followee_id", "followeeid",
        "followed_id", "followee", "user2"
    ]
)

print("\nAll required column mappings identified successfully.")

# ================================================================
# 4. CLEAN DATA
# ================================================================

users = users.drop_duplicates().copy()
photos = photos.drop_duplicates().copy()
likes = likes.drop_duplicates().copy()
follows = follows.drop_duplicates().copy()

if comments is not None:
    comments = comments.drop_duplicates().copy()

if photo_tags is not None:
    photo_tags = photo_tags.drop_duplicates().copy()

if tags is not None:
    tags = tags.drop_duplicates().copy()

if photo_date_col:
    photos[photo_date_col] = pd.to_datetime(
        photos[photo_date_col],
        errors="coerce",
        utc=True
    )

print("\nDATA QUALITY CHECK")

for name, df in [
    ("Users", users),
    ("Photos", photos),
    ("Likes", likes),
    ("Follows", follows),
    ("Comments", comments),
    ("Photo Tags", photo_tags),
    ("Tags", tags)
]:
    if df is not None:
        print(f"\n{name}: {df.shape}")
        print("Missing values:", int(df.isnull().sum().sum()))

# ================================================================
# 5. CALCULATE LIKES PER PHOTO
# ================================================================

like_counts = (
    likes.groupby(like_photo_col)
    .size()
    .rename("likes")
)

post_data = pd.DataFrame({
    "photo_id": photos[photo_id_col].values,
    "user_id": photos[photo_user_col].values
})

if photo_date_col:
    post_data["post_date"] = photos[photo_date_col].values

post_data = post_data.merge(
    like_counts,
    left_on="photo_id",
    right_index=True,
    how="left"
)

post_data["likes"] = post_data["likes"].fillna(0)

# ================================================================
# 6. CALCULATE COMMENTS
# ================================================================

post_data["comments"] = 0

if comments is not None:
    comment_photo_col = find_col(
        comments,
        ["photo_id", "photoid", "photo"],
        required=False
    )

    if comment_photo_col:
        comment_counts = (
            comments.groupby(comment_photo_col)
            .size()
            .rename("comments")
        )

        post_data = post_data.drop(
            columns=["comments"]
        ).merge(
            comment_counts,
            left_on="photo_id",
            right_index=True,
            how="left"
        )

        post_data["comments"] = (
            post_data["comments"].fillna(0)
        )

    else:
        print("WARNING: No recognizable photo column in comments.csv.")

else:
    print(
        "Comments analysis unavailable: comments.csv is missing. "
        "Comment values are placeholders, not actual counts."
    )

post_data["total_engagement"] = (
    post_data["likes"] + post_data["comments"]
)

print("\nPOST ENGAGEMENT DATA")
display(post_data.head(10))

# ================================================================
# 7. FOLLOWER COUNTS AND ENGAGEMENT RATE
# ================================================================

follower_counts = (
    follows.groupby(followee_col)[follower_col]
    .nunique()
    .rename("followers")
)

post_data = post_data.merge(
    follower_counts,
    left_on="user_id",
    right_index=True,
    how="left"
)

post_data["followers"] = post_data["followers"].fillna(0)

post_data["engagement_rate_pct"] = np.where(
    post_data["followers"] > 0,
    post_data["total_engagement"]
    / post_data["followers"] * 100,
    np.nan
)

# ================================================================
# 8. OVERALL SUMMARY
# ================================================================

summary = pd.DataFrame({
    "Metric": [
        "Total Users",
        "Total Photos",
        "Total Like Records",
        "Total Comment Records",
        "Total Follow Records",
        "Average Likes Per Photo",
        "Average Comments Per Photo",
        "Average Engagement Per Photo",
        "Average Engagement Rate (%)"
    ],
    "Value": [
        users[user_id_col].nunique(),
        post_data["photo_id"].nunique(),
        len(likes),
        len(comments) if comments is not None else np.nan,
        len(follows),
        post_data["likes"].mean(),
        post_data["comments"].mean(),
        post_data["total_engagement"].mean(),
        post_data["engagement_rate_pct"].mean()
    ]
})

print("\nOVERALL SUMMARY")
display(summary.round(2))

save_csv(summary, "instagram_overall_summary.csv")

# ================================================================
# 9. POSTING DAY AND HOUR ANALYSIS
# ================================================================

day_analysis = pd.DataFrame()
hour_analysis = pd.DataFrame()

if photo_date_col:
    post_data["post_date"] = pd.to_datetime(
        post_data["post_date"],
        errors="coerce",
        utc=True
    )

    post_data["posting_day"] = (
        post_data["post_date"].dt.day_name()
    )

    post_data["posting_hour"] = (
        post_data["post_date"].dt.hour
    )

    day_order = [
        "Monday", "Tuesday", "Wednesday",
        "Thursday", "Friday", "Saturday", "Sunday"
    ]

    day_analysis = (
        post_data.dropna(subset=["posting_day"])
        .groupby("posting_day")
        .agg(
            posts=("photo_id", "count"),
            avg_likes=("likes", "mean"),
            avg_comments=("comments", "mean"),
            avg_engagement=("total_engagement", "mean")
        )
        .reindex(day_order)
        .dropna(how="all")
    )

    hour_analysis = (
        post_data.dropna(subset=["posting_hour"])
        .groupby("posting_hour")
        .agg(
            posts=("photo_id", "count"),
            avg_likes=("likes", "mean"),
            avg_comments=("comments", "mean"),
            avg_engagement=("total_engagement", "mean")
        )
    )

    print("\nENGAGEMENT BY DAY")
    display(day_analysis.round(2))

    print("\nENGAGEMENT BY HOUR (UTC)")
    display(hour_analysis.round(2))

    if not day_analysis.empty:
        day_analysis["avg_engagement"].plot(
            kind="bar", figsize=(10, 5)
        )
        plt.title("Average Engagement by Posting Day")
        plt.xlabel("Day")
        plt.ylabel("Average Likes + Comments")
        save_chart("engagement_by_day.png")

    if not hour_analysis.empty:
        hour_analysis["avg_engagement"].plot(
            kind="bar", figsize=(12, 5)
        )
        plt.title("Average Engagement by Posting Hour (UTC)")
        plt.xlabel("Hour")
        plt.ylabel("Average Likes + Comments")
        save_chart("engagement_by_hour.png")

    valid_days = day_analysis[day_analysis["posts"] >= 2]
    valid_hours = hour_analysis[hour_analysis["posts"] >= 2]

    if not valid_days.empty:
        print(
            "Best observed day:",
            valid_days["avg_engagement"].idxmax()
        )

    if not valid_hours.empty:
        print(
            "Best observed UTC hour:",
            valid_hours["avg_engagement"].idxmax()
        )

else:
    print("No posting date column found. Time analysis skipped.")

# ================================================================
# 10. HASHTAG ANALYSIS
# ================================================================

hashtag_analysis = pd.DataFrame()

if photo_tags is not None and tags is not None:

    pt_photo_col = find_col(
        photo_tags,
        ["photo_id", "photoid", "photo"],
        required=False
    )

    pt_tag_col = find_col(
        photo_tags,
        ["tag_id", "tagid", "tag"],
        required=False
    )

    tag_id_col = find_col(
        tags,
        ["id", "tag_id", "tagid", "tag"],
        required=False
    )

    tag_name_col = find_col(
        tags,
        ["tag_name", "tagname", "name", "tag"],
        required=False
    )

    if all([
        pt_photo_col, pt_tag_col,
        tag_id_col, tag_name_col
    ]):
        tag_map = photo_tags[
            [pt_photo_col, pt_tag_col]
        ].copy()

        tag_map.columns = ["photo_id", "tag_id"]

        tag_lookup = tags[
            [tag_id_col, tag_name_col]
        ].copy()

        tag_lookup.columns = ["tag_id", "hashtag"]

        tag_data = tag_map.merge(
            tag_lookup,
            on="tag_id",
            how="left"
        )

        tag_data = tag_data.merge(
            post_data[
                ["photo_id", "likes", "comments", "total_engagement"]
            ],
            on="photo_id",
            how="inner"
        )

        hashtag_analysis = (
            tag_data.groupby("hashtag")
            .agg(
                posts=("photo_id", "nunique"),
                total_likes=("likes", "sum"),
                total_comments=("comments", "sum"),
                avg_engagement=("total_engagement", "mean")
            )
            .sort_values("avg_engagement", ascending=False)
        )

        print("\nTOP 15 HASHTAGS")
        display(hashtag_analysis.head(15).round(2))

        if not hashtag_analysis.empty:
            hashtag_analysis.head(15).sort_values(
                "avg_engagement"
            )["avg_engagement"].plot(
                kind="barh", figsize=(10, 6)
            )

            plt.title("Top Hashtags by Average Engagement")
            save_chart("hashtag_analysis.png")

        save_csv(
            hashtag_analysis,
            "instagram_hashtag_analysis.csv",
            index=True
        )

    else:
        print("Hashtag analysis skipped: columns do not match.")

else:
    print("Hashtag analysis skipped: tag files are missing.")

# ================================================================
# 11. USER PERFORMANCE ANALYSIS
# ================================================================

followers = (
    follows.groupby(followee_col)[follower_col]
    .nunique()
    .rename("followers")
)

following = (
    follows.groupby(follower_col)[followee_col]
    .nunique()
    .rename("following")
)

user_analysis = users.rename(
    columns={user_id_col: "user_id"}
).copy()

user_analysis = user_analysis.merge(
    followers,
    left_on="user_id",
    right_index=True,
    how="left"
)

user_analysis = user_analysis.merge(
    following,
    left_on="user_id",
    right_index=True,
    how="left"
)

user_analysis[["followers", "following"]] = (
    user_analysis[["followers", "following"]].fillna(0)
)

user_post_summary = (
    post_data.groupby("user_id")
    .agg(
        posts=("photo_id", "count"),
        total_likes=("likes", "sum"),
        total_comments=("comments", "sum"),
        avg_engagement=("total_engagement", "mean")
    )
    .reset_index()
)

user_analysis = user_analysis.merge(
    user_post_summary,
    on="user_id",
    how="left"
)

user_analysis["posts"] = user_analysis["posts"].fillna(0)

print("\nTOP 10 USERS BY FOLLOWERS")
display(
    user_analysis.sort_values(
        "followers", ascending=False
    ).head(10)
)

print("\nTOP 10 USERS BY ENGAGEMENT")
display(
    user_analysis.sort_values(
        "avg_engagement", ascending=False
    ).head(10)
)

save_csv(user_analysis, "instagram_user_analysis.csv")

# ================================================================
# 12. TOP 20 POSTS
# ================================================================

top_posts = post_data.sort_values(
    "total_engagement",
    ascending=False
).head(20)

print("\nTOP 20 POSTS")
display(top_posts)

save_csv(top_posts, "instagram_top_posts.csv")

# ================================================================
# 13. RECOMMENDED POSTING CALENDAR
# ================================================================

calendar_rows = []

if not day_analysis.empty and not hour_analysis.empty:

    valid_days = day_analysis[day_analysis["posts"] >= 2]
    valid_hours = hour_analysis[hour_analysis["posts"] >= 2]

    if not valid_days.empty and not valid_hours.empty:

        best_days = valid_days.sort_values(
            "avg_engagement", ascending=False
        ).head(3).index.tolist()

        best_hours = valid_hours.sort_values(
            "avg_engagement", ascending=False
        ).head(2).index.tolist()

        for day in best_days:
            for hour in best_hours:
                calendar_rows.append({
                    "Recommended_Day": day,
                    "Recommended_Hour_UTC": int(hour),
                    "Recommendation": "Test content and measure results"
                })

recommended_calendar = pd.DataFrame(calendar_rows)

print("\nRECOMMENDED POSTING CALENDAR")
display(recommended_calendar)

save_csv(
    recommended_calendar,
    "instagram_recommended_calendar.csv"
)

